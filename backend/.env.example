PROJECT_NAME="Belief Stress Test"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Managed PostgreSQL connection URL (e.g., Neon PostgreSQL with ?sslmode=require)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Cryptographic signing secret (minimum 32 characters)
SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=bst_session
COOKIE_SECURE=True
COOKIE_SAMESITE=none

# Comma-separated list of allowed frontend origins (e.g. your production Vercel URL)
CORS_ORIGINS=https://your-frontend-app.vercel.app

# Initial Admin Bootstrap (idempotent on first startup when INITIAL_ADMIN_PASSWORD is set)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@classroom.edu
INITIAL_ADMIN_PASSWORD=

# Gemini AI Provider Configuration (never exposed to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
